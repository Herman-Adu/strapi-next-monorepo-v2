# Production Environment Variables Template
# Copy this file and configure with actual production secrets
# Location: Copy to VPS at /var/www/strapi/.env
# Status: DO NOT commit to Git | DO NOT use placeholder values in production

###############################################################################
# ⚠️  CRITICAL SECURITY NOTICE
###############################################################################
# 1. Replace ALL placeholder values with cryptographically secure secrets
# 2. Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 3. Store secrets in password manager (1Password, Bitwarden, etc.)
# 4. Rotate secrets every 90 days
# 5. NEVER commit this file to version control
# 6. Verify .env is in .gitignore

###############################################################################
# Node Environment
###############################################################################
NODE_ENV=production

###############################################################################
# Strapi Configuration
###############################################################################

# Public URL (accessible from internet)
PUBLIC_URL=https://api.yourdomain.com

# Host and Port (internal - NGINX proxies to this)
HOST=0.0.0.0
PORT=1337

###############################################################################
# Database Configuration (PostgreSQL)
###############################################################################

# ⚠️  REPLACE WITH SECURE VALUES FROM STEP 2 (Security Hardening)
# Format: postgresql://username:password@host:port/database?schema=public

# Option 1: Connection URL (recommended)
DATABASE_URL=postgresql://strapi_app:SECURE_PASSWORD_HERE@localhost:5432/strapi_prod?schema=public&ssl=true

# Option 2: Individual components (alternative)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi_prod
# DATABASE_USERNAME=strapi_app
# DATABASE_PASSWORD=SECURE_PASSWORD_HERE
# DATABASE_SSL=true

###############################################################################
# Strapi Security Keys (ALL REQUIRED)
###############################################################################

# APP_KEYS: 4 comma-separated base64 strings (minimum)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Run 4 times, comma-separate
APP_KEYS=REPLACE_KEY_1,REPLACE_KEY_2,REPLACE_KEY_3,REPLACE_KEY_4

# API Token Salt
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
API_TOKEN_SALT=REPLACE_WITH_SECURE_SALT

# Admin JWT Secret
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
ADMIN_JWT_SECRET=REPLACE_WITH_SECURE_SECRET

# Transfer Token Salt
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
TRANSFER_TOKEN_SALT=REPLACE_WITH_SECURE_SALT

# JWT Secret
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
JWT_SECRET=REPLACE_WITH_SECURE_SECRET

###############################################################################
# AWS S3 Configuration (OPTIONAL - Only if using S3 for uploads)
###############################################################################
# Note: VPS deployment has persistent storage, S3 not required
# Uncomment and configure if you want to use S3 anyway

# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_ACCESS_SECRET=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET=your-strapi-uploads-bucket

###############################################################################
# Email Configuration (OPTIONAL)
###############################################################################
# Configure if Strapi needs to send emails (password reset, etc.)

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

###############################################################################
# Logging Configuration
###############################################################################

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Enable query logging (useful for debugging, disable in production for performance)
DATABASE_LOG=false

###############################################################################
# CORS Configuration
###############################################################################

# Allowed origins (comma-separated)
CORS_ORIGIN=https://yourdomain.com

###############################################################################
# Rate Limiting (Optional but recommended)
###############################################################################

# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_DURATION=60000

###############################################################################
# Admin Panel Configuration
###############################################################################

# Admin panel path (change for additional security)
# ADMIN_PATH=/admin

# Disable admin in production (if managing via API only)
# ADMIN_DISABLED=false

###############################################################################
# Webhooks Configuration (Optional)
###############################################################################

# WEBHOOK_SECRET=your_webhook_secret

###############################################################################
# Monitoring and Error Tracking (Optional)
###############################################################################

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

###############################################################################
# VERCEL FRONTEND ENVIRONMENT VARIABLES
###############################################################################
# These are configured in Vercel dashboard, not in this file
# Listed here for reference only

# Client-side (NEXT_PUBLIC_* prefix required)
# NEXT_PUBLIC_STRAPI_URL=https://api.yourdomain.com
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Server-side
# STRAPI_API_URL=https://api.yourdomain.com
# STRAPI_API_TOKEN=your_strapi_api_token (generated in Strapi admin)
# NEXTAUTH_URL=https://yourdomain.com
# NEXTAUTH_SECRET=your_nextauth_secret (generate with crypto)
# JWT_SECRET=your_jwt_secret (generate with crypto)
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# NODE_ENV=production

###############################################################################
# SECRET GENERATION COMMANDS
###############################################################################
# Copy these commands to generate secure secrets:

# Generate 16-byte secret (for most Strapi secrets):
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# Generate 32-byte secret (for highly sensitive secrets):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Generate 4 APP_KEYS at once:
# node -e "console.log([1,2,3,4].map(() => require('crypto').randomBytes(16).toString('base64')).join(','))"

###############################################################################
# SECURITY CHECKLIST BEFORE USING THIS FILE
###############################################################################
# [ ] Replace ALL "REPLACE_" placeholder values
# [ ] Generate all secrets using crypto.randomBytes()
# [ ] Store secrets in password manager
# [ ] Verify .env is not committed to Git
# [ ] Set file permissions: chmod 600 .env
# [ ] Test database connection with new credentials
# [ ] Document secret rotation schedule (90 days)
# [ ] Configure off-site backup encryption key
# [ ] Setup monitoring alerts for failed authentication

###############################################################################
# FILE DEPLOYMENT INSTRUCTIONS
###############################################################################

# 1. Copy this template to VPS:
#    scp .env.production.template strapi@your-vps-ip:/var/www/strapi/.env

# 2. SSH into VPS:
#    ssh strapi@your-vps-ip

# 3. Edit file with actual secrets:
#    nano /var/www/strapi/.env

# 4. Set secure permissions:
#    chmod 600 /var/www/strapi/.env
#    chown strapi:strapi /var/www/strapi/.env

# 5. Verify no Git tracking:
#    cd /var/www/strapi
#    git status  # Should not show .env file

# 6. Test configuration:
#    cd /var/www/strapi/current
#    yarn strapi console
#    # Should connect to database without errors

###############################################################################
# EMERGENCY SECRET ROTATION PROCEDURE
###############################################################################
# If secrets are compromised:

# 1. Generate new secrets immediately
# 2. Update .env file on VPS
# 3. Restart Strapi: pm2 restart strapi-backend
# 4. Invalidate all API tokens in Strapi admin
# 5. Force logout all admin users
# 6. Generate new API tokens for frontend
# 7. Update Vercel environment variables
# 8. Redeploy frontend: vercel --prod
# 9. Monitor logs for unauthorized access attempts
# 10. Document incident and update security procedures

