# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/
build

# other
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# turbo
.turbo

#jetbrains IDEs
.idea

.cache

.strapi-updater.json

*storybook.log
storybook-static

# test compiled output (TypeScript)
apps/ui/tests/e2e/*.js
apps/ui/tests/e2e/*.js.map
apps/ui/tests/e2e/*.d.ts
apps/ui/tests/e2e/**/*.js
apps/ui/tests/e2e/**/*.js.map
apps/ui/tests/e2e/**/*.d.ts
# Preserve config files
!apps/ui/tests/e2e/*.config.js

# test artifacts
test-results/
playwright-report/
playwright/.cache/
*.trace.zip
/test-results/
/ci-artifacts/
/test-artifacts/
/.github-artifacts-e2e/
e2e_full_log.txt
github-actions-log-latest.txt

# API response snapshots and temporary files
api-response.json
commit-*.txt
commit-message-*.txt

# TypeScript build info
*.tsbuildinfo

# TypeScript compiled output - Sentry configs (Next.js uses .ts files)
apps/ui/sentry.*.config.js

# TypeScript compiled output - Test configs (should use .ts files)
apps/ui/vitest.config.js
apps/ui/vitest.setup.js
apps/ui/playwright.config.js

# TypeScript compiled output - Package files (should only be in dist/)
packages/shared-data/index.js
packages/shared-data/strapi-types.js

# TypeScript compiled output - Strapi types (should only be in build/)
apps/strapi/types/index.js
apps/strapi/types/internals.js

# TypeScript compiled output - Strapi seed files (should only be in build/)
apps/strapi/database/seeds/e2e-test-data.js
apps/strapi/database/seeds/e2e-test-data-safe.js

# Temporary CI analysis artifacts
temp-*/
/temp-*/
apps/ui/temp-*
