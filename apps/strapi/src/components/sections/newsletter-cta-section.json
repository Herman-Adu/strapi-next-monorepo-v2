{
  "collectionName": "components_sections_newsletter_cta_sections",
  "info": {
    "displayName": "NewsletterCTASection",
    "description": "Newsletter subscription CTA section with GDPR compliance"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "inputPlaceholder": {
      "type": "string",
      "default": "Enter your email"
    },
    "buttonText": {
      "type": "string",
      "default": "Subscribe"
    },
    "gdprLabel": {
      "type": "string",
      "required": true,
      "default": "I agree to the terms and conditions"
    },
    "gdprLink": {
      "type": "component",
      "repeatable": false,
      "component": "utilities.link",
      "required": true
    },
    "ctaButtons": {
      "type": "component",
      "repeatable": true,
      "component": "elements.icon-button",
      "max": 2
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "elements.list-item",
      "max": 2
    }
  }
}
