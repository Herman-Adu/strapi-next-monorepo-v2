{
  "name": "@repo/strapi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "build": "strapi build",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "db:restore-snapshot": "bash scripts/restore-snapshot.sh",
    "db:snapshot": "bash scripts/snapshot-db.sh",
    "dev": "yarn develop",
    "dev:with-db": "yarn run:db && yarn develop",
    "develop": "strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "find-data": "bash scripts/find-data.sh",
    "generate": "strapi generate",
    "generate:token": "node scripts/run-generate-token.js",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "list:containers": "bash scripts/list-docker-containers.sh",
    "migrate:docker": "bash scripts/migrate-from-docker.sh",
    "migrate:docker-sqlite": "bash scripts/migrate-from-docker-sqlite.sh",
    "migrate:sqlite": "bash scripts/migrate-from-sqlite.sh",
    "restore:home": "node scripts/run-restore-home-page.js",
    "run:db": "docker compose up -d db",
    "seed:e2e": "bash scripts/seed-e2e-data.sh",
    "seed:e2e:safe": "bash scripts/seed-e2e-data-safe.sh",
    "seed:e2e:win": "powershell -ExecutionPolicy Bypass -File ./scripts/seed-e2e-data.ps1",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "jest --forceExit --detectOpenHandles",
    "transfer": "strapi transfer"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".tmp",
      ".cache"
    ]
  },
  "dependencies": {
    "@_sh/strapi-plugin-ckeditor": "^7.0.0",
    "@repo/design-system": "*",
    "@repo/shared-data": "*",
    "@strapi/plugin-color-picker": "^5.29.0",
    "@strapi/plugin-sentry": "^5.33.0",
    "@strapi/plugin-seo": "2.0.9",
    "@strapi/plugin-users-permissions": "^5.29.0",
    "@strapi/provider-email-mailgun": "^5.33.0",
    "@strapi/provider-upload-aws-s3": "^5.29.0",
    "@strapi/strapi": "^5.29.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "qs": "^6.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-config-sync": "2.1.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x.x",
    "yarn": "1.22.x"
  },
  "strapi": {
    "uuid": "@repo/strapi"
  }
}
