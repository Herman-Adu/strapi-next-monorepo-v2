{
  "name": "strapi-next-monorepo-starter",
  "version": "2.0.0",
  "private": true,
  "author": {
    "name": "Notum Technologies",
    "email": "info@notum.cz",
    "url": "https://notum.cz"
  },
  "maintainers": [
    {
      "name": "Notum Technologies",
      "email": "info@notum.cz",
      "url": "https://notum.cz"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "backup:db": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-database.ps1",
    "build": "yarn clean && turbo build --cache-dir=.turbo",
    "build:strapi": "yarn clean:strapi && turbo run build --filter=@repo/strapi",
    "build:ui": "yarn clean:ui && turbo run build --filter=@repo/ui",
    "chromatic": "turbo run chromatic --filter=@repo/ui",
    "clean": "yarn clean:strapi && yarn clean:ui && yarn clean:turbo",
    "clean:strapi": "rimraf apps/strapi/dist && echo 'Cleaned Strapi dist folder'",
    "clean:turbo": "rimraf .turbo && echo 'Cleaned Turbo cache'",
    "clean:ui": "rimraf apps/ui/.next && echo 'Cleaned UI .next folder'",
    "clear:port": "powershell -ExecutionPolicy Bypass -File ./scripts/utils/clear-strapi-connections.ps1",
    "commit": "git-cz",
    "commit:quick": "powershell -ExecutionPolicy Bypass -File ./scripts/commit.ps1",
    "dev": "node ./scripts/dev-orchestrated.js",
    "dev:all": "turbo dev",
    "dev:strapi": "turbo run dev --filter=@repo/strapi",
    "dev:ui": "turbo run dev --filter=@repo/ui",
    "format": "prettier --write --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "format:check": "prettier --check --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "generate:component": "node ./scripts/generate-component.js",
    "generate:types": "node ./scripts/generate-types.js",
    "heroku-postbuild": "bash ./scripts/heroku/heroku-postbuild.sh",
    "preinstall": "npx only-allow yarn",
    "postinstall": "yarn setup:apps",
    "kill:port": "powershell -ExecutionPolicy Bypass -File ./scripts/utils/kill-port.ps1",
    "lighthouse": "lhci autorun",
    "lint": "turbo lint",
    "prepare": "husky",
    "setup:apps": "node ./scripts/setup-env.js",
    "start:strapi": "turbo run start --filter=@repo/strapi",
    "start:ui": "turbo run start --filter=@repo/ui",
    "storybook": "turbo run storybook --filter=@repo/ui",
    "test": "turbo run test --filter=@repo/ui",
    "test:e2e": "turbo run test:e2e --filter=@repo/ui",
    "test:ui": "turbo run test:ui --filter=@repo/ui"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": "@repo/prettier-config",
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@lhci/cli": "^0.13.0",
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/typescript-config": "*",
    "chromatic": "^13.3.3",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.1",
    "lint-staged": "15.2.7",
    "prettier": "3.3.2",
    "prettier-plugin-packagejson": "^2.5.1",
    "rimraf": "^6.1.0",
    "turbo": "^2.6.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x.x",
    "yarn": "1.22.x"
  },
  "comments": {
    "prettier": "bump to 3.3.3 destroys types schemas generated by Strapi (@strapi/typescript-utils > generators > utils > prettier.format())"
  }
}
